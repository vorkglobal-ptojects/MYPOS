# ==============================================================================
# MIFOS MONOREPO ROOT ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Backend API Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Connection
# Use pooled connection (port 6543) for DATABASE_URL with pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&connect_timeout=15
# Use direct connection (port 5432) for migrations and prepared statements
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[POOLER_HOST]:5432/postgres?connect_timeout=15

# Supabase API Credentials
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# Backend JWT Secret for Session Generation
JWT_SECRET=[GENERATE_A_SECURE_RANDOM_SECRET_KEY_HERE]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
