# ==============================================================================
# MIFOS BACKEND SERVICE ENVIRONMENT TEMPLATE
# Location: /backend/.env.example
# ==============================================================================

PORT=4000
NODE_ENV=development

# Pooled connection string with Transaction Pooler (?pgbouncer=true)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session connection string for Prisma migrations & DDL
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase Service & Admin Credentials
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Authentication & Security
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

